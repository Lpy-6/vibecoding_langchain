# ---- 模型服务（阿里云百炼）----
# 填入后重启后端即可切换为真实模型；留空则自动进入离线检索 + 抽取式回答模式
DASHSCOPE_API_KEY=
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=1024
RERANK_MODEL=gte-rerank-v2
OCR_MODEL=qwen-vl-ocr
# auto: 有 Key 用百炼，无 Key 用离线模式；也可强制 dashscope / mock
LLM_MODE=auto

# ---- 应用 ----
APP_ENV=dev
DATA_DIR=./data
JWT_SECRET=please-change-this-to-a-random-32-byte-secret
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=7
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456
SEED_DEMO_USER=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- 检索与缓存 ----
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
CACHE_FUZZY_THRESHOLD=0.95
RETRIEVAL_TOP_K_DENSE=40
RETRIEVAL_TOP_K_SPARSE=40
RERANK_TOP_N=8
CONTEXT_CHAR_BUDGET=6000
PARENT_CHUNK_SIZE=1200
CHILD_CHUNK_SIZE=300

# ---- 限流 / 上传 ----
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_LOGIN_PER_MIN=15
RATE_LIMIT_REGISTER_PER_MIN=10
MAX_UPLOAD_MB=50
INGEST_WORKERS=4
INGEST_MAX_ATTEMPTS=3
